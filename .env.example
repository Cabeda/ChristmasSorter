# Copy to .env.local for local development. Never commit real values.

# SMTP credentials used by /api/email and /api/retry.
MAIL_ADDRESS=you@example.com
MAIL_PASSWORD=your-app-password

# Optional SMTP overrides (defaults: smtp.gmail.com:587, STARTTLS).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Required. Encrypts the opaque draw token returned for retries.
# Generate one with: openssl rand -base64 48
SORTER_SECRET=

# Optional. Comma-separated browser origins allowed to call the API.
# Defaults to same-host only, and rejects a missing Origin in production.
# ALLOWED_ORIGINS=https://christmas-sorter.vercel.app

# Optional rate limiting (defaults: 8 requests / 10 minutes per IP/endpoint).
# RATE_LIMIT_MAX=8
# RATE_LIMIT_WINDOW_MS=600000
